# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/procuraos

# Security — generate independent random secrets of at least 32 characters
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
# Generate 32 random bytes and encode as 64 hex characters; required in production
MFA_ENCRYPTION_KEY=replace-with-64-hex-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Web
VITE_API_BASE_URL=http://localhost:4000/api/v1
