# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/procuraos

# Security — replace with a cryptographically random value (32+ bytes)
JWT_ACCESS_SECRET=replace-this-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-this-with-another-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Web
VITE_API_BASE_URL=http://localhost:4000/api/v1
